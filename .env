# Discord Bot
DISCORD_TOKEN=YOUR_DISCORD_BOT_TOKEN
OWNER_ID=YOUR_DISCORD_USER_ID

# Database
DB_PATH=vps.db

# LXC / LXD
LXC_IMAGE=images:ubuntu/22.04
LXC_STORAGE=
VMID_START=1000

# Tailscale
TAILSCALE_API_KEY=YOUR_TAILSCALE_API_KEY

# SSH
SSH_PORT=22

# Logging
LOG_LEVEL=INFO

# Normal user deploy limit
# 0 = unlimited
FREE_PER_USER_LIMIT=1
